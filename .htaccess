DirectoryIndex index.html

# Ensure proper MIME types for modern JS modules on cPanel
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/webp .webp
</IfModule>

# SPA Routing Fallback for React, PHP API & Direct /admin Access
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization header to PHP API on cPanel / Apache CGI
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Route local API and uploads directly without SPA fallback
  RewriteRule ^api(/.*)?$ - [L]
  RewriteRule ^uploads(/.*)?$ - [L]

  # Route asset and API requests under direct /admin URLs to root paths
  RewriteRule ^admin/api/(.*)$ api/$1 [L,QSA]
  RewriteRule ^admin/uploads/(.*)$ uploads/$1 [L,QSA]
  RewriteRule ^admin/api-config\.js$ api-config.js [L,QSA]
  RewriteRule ^admin/assets/(.*)$ assets/$1 [L,QSA]
  RewriteRule ^admin/banners/(.*)$ banners/$1 [L,QSA]
  RewriteRule ^admin/logo\.jpg$ logo.jpg [L,QSA]
  RewriteRule ^admin/favicon\.jpg$ favicon.jpg [L,QSA]

  # Direct /admin route without requiring #/admin
  RewriteRule ^admin/?$ index.html [L,QSA]
  RewriteRule ^admin/(.*)$ index.html [L,QSA]

  # Standard SPA fallback for other non-file routes
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>

# Prevent stale HTML/API-config caching while caching static images
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <Files "api-config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>
